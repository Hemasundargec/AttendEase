# Public values only. Anything prefixed VITE_ ends up in the browser bundle,
# so NEVER put a secret key here.
VITE_SITE_URL=https://your-domain.example
# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Optional.
VITE_GA_ID=
# Cloudflare Turnstile SITE key (public). Optional. The SECRET key lives on the server only.
VITE_TURNSTILE_SITE_KEY=
