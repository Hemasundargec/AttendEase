# Copy to .env for local use. NEVER commit .env.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string. Required in production. Without it, development mode writes to data/waitlist.jsonl
MONGODB_URI=
# Random string used to sign the anti-spam form token. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=
# Optional Cloudflare Turnstile SECRET key (server only). The matching SITE key goes in client/.env as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET=
# Your public hostname, no scheme (e.g. attendease.example). Pins the HTTP->HTTPS redirect target. Recommended in production.
CANONICAL_HOST=
# Random string (32+ chars) that signs login cookies. Must differ from FORM_SECRET. Required in production.
JWT_SECRET=
# Optional: extra origins allowed to make state-changing API calls, comma separated (e.g. a separate front-end domain).
ALLOWED_ORIGINS=
# bcrypt cost factor (default 12). Raise slowly as hardware improves.
BCRYPT_COST=12
# Email (optional). Without these, verification codes and reminders are printed to the server log and NOT sent.
# Resend (https://resend.com): create an API key and verify a sending domain.
RESEND_API_KEY=
MAIL_FROM=AttendEase <reminders@your-domain.example>
# Public site URL, used for the unsubscribe link in reminder emails.
SITE_URL=
# Set to "off" to disable the reminder scheduler (e.g. on a second server copy).
REMINDERS_SCHEDULER=
